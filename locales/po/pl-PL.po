#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Źródła fragmentów YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Rozdzielona przecinkami lista plików YAML lub katalogów casc.d scalanych w deterministycznej kolejności leksykalnej."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Polityka scalania fragmentów"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Tryb ścisły odrzuca sprzeczne klucze skalarne między fragmentami; tryb nakładki pozwala późniejszym fragmentom nadpisywać wcześniejsze wartości."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Ścisły (błąd przy konfliktach skalarnych)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Nakładka (późniejsze fragmenty nadpisują)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Katalog pakietów monitorowania"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Katalog bazowy zawierający wersjonowane pakiety monitorowania YAML i pliki blokad."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zachowaj tabele wtyczki podczas odinstalowywania"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Zachowaj tabele plugin_yaml_packs, plugin_yaml_queries oraz plugin_yaml_audit podczas odinstalowywania wtyczki."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Wtyczka YAML wymaga PHP %s lub nowszego. Ten serwer korzysta z PHP %s, więc wtyczka nie została zainstalowana ani włączona."

