msgstr "Walidacja tokenu CSRF nie powiodła się. Odśwież stronę i spróbuj ponownie."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Skonfiguruj yaml_source_paths w ustawieniach Cacti przed uruchomieniem przeładowania."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "W Twojej sesji nie znaleziono pasującego oczekującego planu przeładowania. Najpierw oblicz nowy plan."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
