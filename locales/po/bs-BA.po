msgstr "Validacija CSRF tokena nije uspjela. Ponovo učitajte stranicu i pokušajte opet."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Konfigurišite yaml_source_paths u Cacti postavkama prije pokretanja ponovnog učitavanja."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "U vašoj sesiji nije pronađen odgovarajući plan ponovnog učitavanja na čekanju. Prvo izračunajte novi plan."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "YAML ponovno učitavanje i paketi za nadzor (Administrator)"

