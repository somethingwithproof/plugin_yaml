#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Izvori YAML fragmenata (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Zarezom odvojena lista YAML datoteka ili casc.d direktorija koji se spajaju determinističkim leksičkim redoslijedom."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Pravilo spajanja fragmenata"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Strogi način odbija sukobljene skalarne ključeve između fragmenata; preklapanje omogućava kasnijim fragmentima da nadjačaju ranije vrijednosti."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Strogo (greška pri skalarnim sukobima)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Preklapanje (kasniji fragmenti nadjačavaju)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Direktorij paketa za nadzor"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Osnovni direktorij koji sadrži verzionirane YAML pakete za nadzor i datoteke zaključavanja."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zadrži tabele dodatka pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Sačuvaj tabele plugin_yaml_packs, plugin_yaml_queries i plugin_yaml_audit prilikom deinstalacije dodatka."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Dodatak YAML zahtijeva PHP %s ili noviju verziju. Ovaj server koristi PHP %s, pa dodatak nije instaliran niti omogućen."

#: setup.php
msgid "Import/Export"
msgstr "Uvoz/Izvoz"

