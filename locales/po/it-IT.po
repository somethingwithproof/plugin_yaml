#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Elenco separato da virgole di file YAML o directory casc.d uniti in ordine lessicale deterministico."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Politica di unione dei frammenti"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "La modalità rigorosa rifiuta le chiavi scalari in conflitto tra frammenti; la modalità overlay consente ai frammenti successivi di sovrascrivere i valori precedenti."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Rigorosa (errore in caso di conflitti scalari)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Overlay (i frammenti successivi sovrascrivono)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Directory dei pacchetti di monitoraggio"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Directory di base contenente i pacchetti di monitoraggio YAML con controllo di versione e i file di blocco."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Mantieni tabelle del plugin alla disinstallazione"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Conserva le tabelle plugin_yaml_packs, plugin_yaml_queries e plugin_yaml_audit durante la disinstallazione del plugin."

