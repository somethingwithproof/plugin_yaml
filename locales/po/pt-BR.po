#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Lista separada por vírgulas de arquivos YAML ou diretórios casc.d mesclados em ordem léxica determinística."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Política de mesclagem de fragmentos"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Estrito rejeita chaves escalares conflitantes entre fragmentos; sobreposição permite que fragmentos posteriores substituam valores anteriores."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Estrito (falhar em conflitos escalares)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Sobreposição (fragmentos posteriores substituem)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Diretório de pacotes de monitoramento"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Diretório base contendo pacotes de monitoramento YAML versionados e arquivos de bloqueio."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Manter tabelas do plugin ao desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Preservar as tabelas plugin_yaml_packs, plugin_yaml_queries e plugin_yaml_audit ao desinstalar o plugin."

