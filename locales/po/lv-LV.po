#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Ar komatiem atdalīts YAML datņu vai casc.d direktoriju saraksts, kas apvienots deterministiskā leksikālā secībā."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Fragmentu apvienošanas politika"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Stingrais režīms noraida konfliktējošas skalārās atslēgas starp fragmentiem; pārklājums ļauj vēlākiem fragmentiem pārrakstīt agrākās vērtības."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Stingrais (kļūda skalāru konfliktu gadījumā)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Pārklājums (vēlākie fragmenti pārraksta)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Uzraudzības pakotņu direktorijs"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Pamatdirektorijs, kurā atrodas versionētās YAML uzraudzības pakotnes un bloķēšanas datnes."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Saglabāt spraudņa tabulas atinstalējot"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Saglabāt plugin_yaml_packs, plugin_yaml_queries un plugin_yaml_audit tabulas, atinstalējot spraudni."

