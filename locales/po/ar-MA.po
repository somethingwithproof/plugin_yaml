msgid "YAML Admin"
msgstr "مسؤول YAML"

#: lib/Pages.php
msgid "YAML Schema & Reference"
msgstr "مخطط ومرجع YAML"

#: lib/Pages.php
msgid "YAML Validate & Compile"
msgstr "التحقق من YAML وتصريفه"

#: lib/Pages.php
msgid "YAML Reload & Packs"
msgstr "إعادة تحميل YAML والحزم"

#: lib/Settings.php setup.php
msgid "YAML Templates, Schema & CasC Fragments"
msgstr "قوالب YAML والمخطط ومقاطع CasC"

#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "مصادر مقاطع YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "لائحة مفصولة بفواصل من ملفات YAML أو أدلة casc.d تُدمج بترتيب معجمي حتمي."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "سياسة دمج المقاطع"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "يرفض الوضع الصارم المفاتيح القياسية المتعارضة بين المقاطع؛ بينما يسمح التراكب للمقاطع اللاحقة بتعويض القيم السابقة."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "صارم (فشل عند تعارض المفاتيح القياسية)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "تراكب (المقاطع اللاحقة تعوّض السابقة)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "دليل حزم المراقبة"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "الدليل الأساسي الذي يضم حزم مراقبة YAML المُرقّمة وملفات القفل."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "الاحتفاظ بجداول الملحق عند إزالة التثبيت"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "الاحتفاظ بجداول plugin_yaml_packs وplugin_yaml_queries وplugin_yaml_audit عند إزالة تثبيت الملحق."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "يتطلب ملحق YAML إصدار PHP %s أو أحدث. يشغّل هذا المُلقّم إصدار PHP %s، لذلك لم يُثبّت الملحق أو يُفعّل."

#: setup.php
msgid "Import/Export"
msgstr "استيراد/تصدير"

#: setup.php
msgid "YAML"
msgstr "YAML"

#: setup.php
msgid "The YAML plugin is not enabled."
msgstr "ملحق YAML غير مُفعّل."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later."
msgstr "يتطلب ملحق YAML إصدار PHP %s أو أحدث."

#: yaml_admin.php yaml_operator.php
msgid "CSRF token validation failed. Reload the page and retry."
msgstr "تعذّرت المصادقة على رمز CSRF. أعد تحميل الصفحة وحاول مجدداً."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "قم بتهيئة yaml_source_paths في إعدادات Cacti قبل تشغيل إعادة التحميل."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "لم يُعثر على خطة إعادة تحميل معلّقة مطابقة في جلستك. احسب خطة جديدة أولاً."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "إعادة تحميل YAML وحزم المراقبة (مسؤول)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "حساب خطة إعادة التحميل من المصادر المُهيّأة"

#: yaml_operator.php
msgid "Provide a YAML document to validate or compile."
msgstr "أدخل وثيقة YAML للتحقق منها أو تصريفها."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "تم تصريف %s بنجاح."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "اجتاز نحو YAML والعناصر النائبة وثوابت المعاملات المتقاطعة الفحص بنجاح."

#: yaml_operator.php
msgid "YAML Validate, Compile & Dry-Run Preview (Operator)"
msgstr "التحقق من YAML وتصريفه والمعاينة التجريبية (مشغّل)"

#: yaml_operator.php
msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "قالب YAML أو استعلام معطيات أو مقطع CasC:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "تحقق وإخفاء المعطيات الحساسة"

#: yaml_operator.php
msgid "Compile to Cacti XML"
msgstr "تصريف إلى Cacti XML"

#: yaml_view.php
msgid "YAML Schema, Reference & Redacted State"
msgstr "مخطط YAML والمرجع والحالة المُنقّحة"
