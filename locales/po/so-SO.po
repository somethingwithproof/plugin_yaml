#: lib/Pages.php
msgid "YAML View"
msgstr "Aragtida YAML"

#: lib/Pages.php
msgid "YAML Operator"
msgstr "Hawl-wadeenka YAML"

#: lib/Pages.php
msgid "YAML Admin"
msgstr "Maamulaha YAML"

#: lib/Pages.php
msgid "YAML Schema & Reference"
msgstr "Qaab-dhismeedka & Tixraaca YAML"

#: lib/Pages.php
msgid "YAML Validate & Compile"
msgstr "Xaqiiji & Isku-dubbarid YAML"

#: lib/Pages.php
msgid "YAML Reload & Packs"
msgstr "Dib u Rar & Xirmooyinka YAML"

#: lib/Settings.php setup.php
msgid "YAML Templates, Schema & CasC Fragments"
msgstr "Qaababka YAML, Qaab-dhismeedka & Qaybaha CasC"

#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Ilaha Qaybaha YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Liis hakad lagu kala saaray oo faylasha YAML ah ama galka casc.d oo la isku daro iyadoo la raacayo nidaam xarafeed go'an."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Siyaasadda Isku-darka Qaybaha"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Adag waxay diiddaa furayaasha scalar ee iska hor imaanaya ee qaybaha dhexdooda; dul-saar waxay u oggolaataa qaybaha dambe inay beddelaan qiimayaashii hore."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Adag (ku fashilma iska hor imaadka scalar)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Dul-saar (qaybaha dambe way beddelaan)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Galka Xirmooyinka Kormeerka"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Galka aasaasiga ah ee ay ku jiraan Xirmooyinka Kormeerka YAML ee noocyeysan iyo faylasha qufulka."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Hayso Jadwallada Ku-xiraha Marka La Tirtiro"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Ilaali jadwallada plugin_yaml_packs, plugin_yaml_queries, iyo plugin_yaml_audit marka la tirtirayo ku-xiraha."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Ku-xiraha YAML wuxuu u baahan yahay PHP %s ama ka dambeeya. Serfarkani wuxuu ku shaqeeyaa PHP %s, sidaas darteed ku-xiraha lama rakibin mana la hawlgelin."

#: setup.php
msgid "Import/Export"
msgstr "Soo-dejinta/Dhoofinta"

#: setup.php
msgid "YAML"
msgstr "YAML"

#: setup.php
msgid "The YAML plugin is not enabled."
msgstr "Ku-xiraha YAML ma shaqeynayo."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later."
msgstr "Ku-xiraha YAML wuxuu u baahan yahay PHP %s ama ka dambeeya."

#: yaml_admin.php yaml_operator.php
msgid "CSRF token validation failed. Reload the page and retry."
msgstr "Xaqiijinta calaamadda CSRF way fashilantay. Dib u soo rar bogga oo mar kale isku day."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Ku habee yaml_source_paths gudaha Dejinta Cacti ka hor inta aadan samayn dib-u-rarid."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "Qorshe dib-u-rarid oo sugaya oo u dhigma lagama helin fadhigaaga. Marka hore xisaabi qorshe cusub."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "Dib-u-raridda YAML & Xirmooyinka Kormeerka (Maamule)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "Ka Xisaabi Qorshaha Dib-u-raridda Ilaha La Habeeyay"

#: yaml_operator.php
msgid "Provide a YAML document to validate or compile."
msgstr "Keen dukumiinti YAML ah si loo xaqiijiyo ama loo isku-dubbarido."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "Si guul leh ayaa loo isku-dubbariday %s."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "Naxwaha YAML, buuxiyeyaasha booska, iyo xeerarka u dhexeeya halbeegyada way gudbeen."

#: yaml_operator.php
msgid "YAML Validate, Compile & Dry-Run Preview (Operator)"
msgstr "Xaqiijinta, Isku-dubbaridka & Horudhaca Tijaabada YAML (Hawl-wadeen)"

#: yaml_operator.php
msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "Qaabka YAML, Weydiinta Xogta, ama Qaybta CasC:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "Xaqiiji & Qari Sirta"

#: yaml_operator.php
msgid "Compile to Cacti XML"
msgstr "U Beddel Cacti XML"

#: yaml_view.php
msgid "YAML Schema, Reference & Redacted State"
msgstr "Qaab-dhismeedka YAML, Tixraaca & Xaaladda Sirta La Qariyay"
