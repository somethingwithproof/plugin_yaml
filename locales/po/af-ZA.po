#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Kommageskeide lys van YAML-lêers of casc.d-gidse wat in deterministiese leksikale volgorde saamgevoeg word."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Fragmentsamevoegingsbeleid"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Streng verwerp botsende skalêre sleutels oor fragmente heen; oorleg laat latere fragmente toe om vroeëre waardes te oorheers."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Streng (misluk by skalêre botsings)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Oorleg (latere fragmente oorheers)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Moniteringspakkette-gids"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Basisgids wat weergawe-beheerde YAML-moniteringspakkette en sluitlêers bevat."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Behou inproptabelle by verwydering"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Behou die plugin_yaml_packs-, plugin_yaml_queries- en plugin_yaml_audit-tabelle wanneer die inprop verwyder word."

#: setup.php
