#: lib/Pages.php
msgid "YAML View"
msgstr "Ukubuka kwe-YAML"

#: lib/Pages.php
msgid "YAML Operator"
msgstr "Umsebenzi we-YAML"

#: lib/Pages.php
msgid "YAML Admin"
msgstr "Umlawuli we-YAML"

#: lib/Pages.php
msgid "YAML Schema & Reference"
msgstr "Isakhiwo Nereferensi ye-YAML"

#: lib/Pages.php
msgid "YAML Validate & Compile"
msgstr "Qinisekisa futhi Uhlanganise i-YAML"

#: lib/Pages.php
msgid "YAML Reload & Packs"
msgstr "Layisha Kabusha i-YAML Namaphakethe"

#: lib/Settings.php setup.php
msgid "YAML Templates, Schema & CasC Fragments"
msgstr "Izifanekiso ze-YAML, Isakhiwo Nezingcezu ze-CasC"

#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Imithombo Yezingcezu ze-YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Uhlu oluhlukaniswe ngokhefana lwamafayela e-YAML noma izinkomba ze-casc.d ezihlanganiswa ngokulandelana okuqinisekile kwe-alfabhethi."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Inqubomgomo Yokuhlanganisa Izingcezu"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Okuqinile kwenqaba izihluthulelo ze-scalar ezingqubuzanayo kuzo zonke izingcezu; ukumboza kuvumela izingcezu zakamuva ukuba zishintshe amanani angaphambili."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Okuqinile (yehluleka uma kukhona ukungqubuzana kwe-scalar)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Ukumboza (izingcezu zakamuva ziyashintsha)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Uhla Lwamaphakethe Okuqapha"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Uhla lwesisekelo oluqukethe Amaphakethe Okuqapha e-YAML anezinguqulo namafayela okukhiya."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Gcina Amathebula E-plugin Lapho Ukhipha"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Gcina amathebula e-plugin_yaml_packs, plugin_yaml_queries, ne-plugin_yaml_audit lapho ukhipha i-plugin."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "I-plugin ye-YAML idinga i-PHP %s noma eyakamuva. Le seva isebenzisa i-PHP %s, ngakho-ke i-plugin ayifakwanga noma ayinikwanga amandla."

#: setup.php
msgid "Import/Export"
msgstr "Ngenisa/Khipha"

#: setup.php
msgid "YAML"
msgstr "YAML"

#: setup.php
msgid "The YAML plugin is not enabled."
msgstr "I-plugin ye-YAML ayinikwanga amandla."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later."
msgstr "I-plugin ye-YAML idinga i-PHP %s noma eyakamuva."

#: yaml_admin.php yaml_operator.php
msgid "CSRF token validation failed. Reload the page and retry."
msgstr "Ukuqinisekiswa kwethokheni ye-CSRF kwehlulekile. Layisha kabusha ikhasi bese uzama futhi."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Lungiselela i-yaml_source_paths Kumasethingi e-Cacti ngaphambi kokulayisha kabusha."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "Alukho uhlelo lokulayisha kabusha olulindile olufanayo olutholakele kuseshini yakho. Bala uhlelo olusha kuqala."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "Ukulayisha Kabusha kwe-YAML Namaphakethe Okuqapha (Umlawuli)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "Bala Uhlelo Lokulayisha Kabusha Kusuka Emithonjeni Elungisiwe"

#: yaml_operator.php
msgid "Provide a YAML document to validate or compile."
msgstr "Nikeza idokhumenti ye-YAML ukuze iqinisekiswe noma ihlanganiswe."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "I-%s ihlanganiswe ngempumelelo."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "I-syntax ye-YAML, izibambi-ndawo, nemithetho engaguquki phakathi kwamapharamitha kuphumelele."

#: yaml_operator.php
msgid "YAML Validate, Compile & Dry-Run Preview (Operator)"
msgstr "Ukuqinisekisa, Ukuhlanganisa Nokubuka Kuqala Kokuzama kwe-YAML (Umsebenzi)"

#: yaml_operator.php
msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "Isifanekiso se-YAML, Umbuzo Wedatha, noma Ingcezu ye-CasC:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "Qinisekisa futhi Fihla Imfihlo"

#: yaml_operator.php
msgid "Compile to Cacti XML"
msgstr "Hlanganisa ku-Cacti XML"

#: yaml_view.php
msgid "YAML Schema, Reference & Redacted State"
msgstr "Isakhiwo se-YAML, Ireferensi Nesimo Esifihliwe"
