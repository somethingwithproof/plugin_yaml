#: lib/Pages.php
msgid "YAML View"
msgstr "Imbono ye-YAML"

#: lib/Pages.php
msgid "YAML Operator"
msgstr "Umsebenzi we-YAML"

#: lib/Pages.php
msgid "YAML Admin"
msgstr "Umlawuli we-YAML"

#: lib/Pages.php
msgid "YAML Schema & Reference"
msgstr "Isakhelo neNkomba ye-YAML"

#: lib/Pages.php
msgid "YAML Validate & Compile"
msgstr "Qinisekisa kwaye uHlanganise i-YAML"

#: lib/Pages.php
msgid "YAML Reload & Packs"
msgstr "Layisha kwakhona i-YAML nePakethe"

#: lib/Settings.php setup.php
msgid "YAML Templates, Schema & CasC Fragments"
msgstr "Izakhelo ze-YAML, Isakhelo neZiqwenga ze-CasC"

#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Imithombo yeZiqwenga ze-YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Uluhlu olwahlulwe ngekoma lweefayile ze-YAML okanye oovimba be-casc.d abadityaniswa ngokulandelelana okuzinzileyo kwealfabhethi."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Umgaqo-nkqubo woKudibanisa iZiqwenga"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Okuqinileyo kuyazikhaba izitshixo ze-scalar eziphikisanayo kwiziqwenga; ukugquma kuvumela iziqwenga zamva ukuba zibhale phezu kwamaxabiso angaphambili."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Okuqinileyo (silela xa kukho ukungqubana kwe-scalar)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Ukugquma (iziqwenga zamva ziyabhala phezu kwezangaphambili)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Uvimba weePakethe zoJongo"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Uvimba osisiseko oqulethe iiPakethe zoJongo ze-YAML ezinoguqulelo kunye neefayile zokutshixa."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Gcina iiTheyibhile zePlagin xa uSusa"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Gcina iitheyibhile ze-plugin_yaml_packs, plugin_yaml_queries, ne-plugin_yaml_audit xa ususa iplagin."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Iplagin ye-YAML ifuna i-PHP %s okanye yamva. Le seva isebenzisa i-PHP %s, ngoko ke iplagin ayifakwanga okanye ayivulwanga."

#: setup.php
msgid "Import/Export"
msgstr "Ngenisa/Khuphela ngaphandle"

#: setup.php
msgid "YAML"
msgstr "YAML"

#: setup.php
msgid "The YAML plugin is not enabled."
msgstr "Iplagin ye-YAML ayivulwanga."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later."
msgstr "Iplagin ye-YAML ifuna i-PHP %s okanye yamva."

#: yaml_admin.php yaml_operator.php
msgid "CSRF token validation failed. Reload the page and retry."
msgstr "Ukuqinisekiswa kwethokheni ye-CSRF kusilele. Layisha kwakhona iphepha uze uzame kwakhona."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Qwalasela i-yaml_source_paths kwiisetingi ze-Cacti ngaphambi kokulayisha kwakhona."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "Akukho sicwangciso sokulayisha kwakhona esilindileyo esihambelanayo esifunyenweyo kwiseshoni yakho. Bala isicwangciso esitsha kuqala."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "Ukulayisha kwakhona kwe-YAML neePakethe zoJongo (Umlawuli)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "Bala isicwangciso soKulayisha kwakhona kwiMithombo eQwalaselweyo"

#: yaml_operator.php
msgid "Provide a YAML document to validate or compile."
msgstr "Nika uxwebhu lwe-YAML ukuze luqinisekiswe okanye luhlanganiswe."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "I-%s ihlanganiswe ngempumelelo."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "Isintaksi ye-YAML, izibambi-ndawo, kunye nemiqathango engaguqukiyo phakathi kweeparamitha iphumelele."

#: yaml_operator.php
msgid "YAML Validate, Compile & Dry-Run Preview (Operator)"
msgstr "Ukuqinisekisa, uKuhlanganisa noMbono woKuzama we-YAML (Umsebenzi)"

#: yaml_operator.php
msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "Isakhelo se-YAML, Umbuzo weDatha, okanye iSiqwenga se-CasC:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "Qinisekisa uze uFihle iMfihlo"

#: yaml_operator.php
msgid "Compile to Cacti XML"
msgstr "Hlanganisa kwi-Cacti XML"

#: yaml_view.php
msgid "YAML Schema, Reference & Redacted State"
msgstr "Isakhelo se-YAML, Inkomba neMeko eFihliweyo"
