msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "YAML шаблон, упит података или CasC фрагмент:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "Валидирај и редигуј"

#: yaml_operator.php
msgid "Compile to Cacti XML"
msgstr "Компајлирај у Cacti XML"

