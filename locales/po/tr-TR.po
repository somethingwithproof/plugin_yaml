msgstr "Doğrulamak veya derlemek için bir YAML belgesi sağlayın."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "%s başarıyla derlendi."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "YAML sözdizimi, yer tutucular ve parametreler arası değişmezler doğrulandı."

