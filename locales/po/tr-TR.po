#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Belirlenimci sözlüksel sırayla birleştirilen YAML dosyalarının veya casc.d dizinlerinin virgülle ayrılmış listesi."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Parça Birleştirme Politikası"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Katı mod parçalar arasında çakışan skaler anahtarları reddeder; katmanlama sonraki parçaların önceki değerleri geçersiz kılmasına izin verir."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Katı (skaler çakışmalarda hata ver)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Katmanlama (sonraki parçalar geçersiz kılar)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "İzleme Paketleri Dizini"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Sürümlenmiş YAML İzleme Paketlerini ve kilit dosyalarını içeren temel dizin."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Kaldırırken Eklenti Tablolarını Koru"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Eklenti kaldırılırken plugin_yaml_packs, plugin_yaml_queries ve plugin_yaml_audit tablolarını koru."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "YAML eklentisi PHP %s veya daha yeni bir sürüm gerektirir. Bu sunucuda PHP %s çalışıyor, bu nedenle eklenti kurulmadı veya etkinleştirilmedi."

#: setup.php
msgid "Import/Export"
msgstr "İçe/Dışa Aktar"

#: setup.php
