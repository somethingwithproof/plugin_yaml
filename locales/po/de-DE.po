#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "YAML-Fragmentquellen (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Kommagetrennte Liste von YAML-Dateien oder casc.d-Verzeichnissen, die in deterministischer lexikalischer Reihenfolge zusammengeführt werden."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Richtlinie zum Zusammenführen von Fragmenten"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Strikt lehnt widersprüchliche skalare Schlüssel über Fragmente hinweg ab; Overlay lässt spätere Fragmente frühere Werte überschreiben."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Strikt (Abbruch bei skalaren Konflikten)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Overlay (spätere Fragmente überschreiben)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Verzeichnis für Überwachungspakete"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Basisverzeichnis mit versionierten YAML-Überwachungspaketen und Sperrdateien."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Plugin-Tabellen bei Deinstallation behalten"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Tabellen plugin_yaml_packs, plugin_yaml_queries und plugin_yaml_audit beim Deinstallieren des Plugins beibehalten."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Das YAML-Plugin erfordert PHP %s oder neuer. Auf diesem Server läuft PHP %s, daher wurde das Plugin nicht installiert oder aktiviert."

#: setup.php
msgid "Import/Export"
msgstr "Importieren/Exportieren"

#: setup.php
