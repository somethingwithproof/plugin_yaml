msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "YAML-Neuladen & Überwachungspakete (Administrator)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "Neuladeplan aus konfigurierten Quellen berechnen"

