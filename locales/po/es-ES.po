#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Lista separada por comas de archivos YAML o directorios casc.d combinados en orden lexicográfico determinista."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Política de combinación de fragmentos"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Estricto rechaza claves escalares en conflicto entre fragmentos; superposición permite que los fragmentos posteriores sobrescriban valores anteriores."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Estricto (fallar ante conflictos escalares)"

