msgid "Overlay (later fragments override)"
msgstr "Superposición (los fragmentos posteriores sobrescriben)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Directorio de paquetes de monitorización"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Directorio base que contiene paquetes de monitorización YAML versionados y archivos de bloqueo."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Conservar tablas del complemento al desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Conservar las tablas plugin_yaml_packs, plugin_yaml_queries y plugin_yaml_audit al desinstalar el complemento."

