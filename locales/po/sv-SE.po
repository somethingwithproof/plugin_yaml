#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Kommaseparerad lista över YAML-filer eller casc.d-kataloger som slås samman i deterministisk lexikal ordning."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Policy för sammanfogning av fragment"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Strikt avvisar motstridiga skalärnycklar mellan fragment; överlagring låter senare fragment åsidosätta tidigare värden."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Strikt (misslyckas vid skalärkonflikter)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Överlagring (senare fragment åsidosätter)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Katalog för övervakningspaket"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Baskatalog som innehåller versionshanterade övervakningspaket i YAML och låsfiler."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Behåll tilläggstabeller vid avinstallation"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Bevara tabellerna plugin_yaml_packs, plugin_yaml_queries och plugin_yaml_audit vid avinstallation av tillägget."

#: setup.php
