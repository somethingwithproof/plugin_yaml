#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Liste séparée par des virgules de fichiers YAML ou de dossiers casc.d fusionnés selon un ordre lexicographique déterministe."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Politique de fusion des fragments"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Le mode strict rejette les clés scalaires conflictuelles entre fragments ; le mode superposition laisse les fragments ultérieurs remplacer les valeurs antérieures."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Strict (échec sur conflits scalaires)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Superposition (les fragments ultérieurs écrasent)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Dossier des packs de supervision"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Dossier racine contenant les packs de supervision YAML versionnés et les fichiers de verrouillage."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Conserver les tables du module lors de la désinstallation"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Conserver les tables plugin_yaml_packs, plugin_yaml_queries et plugin_yaml_audit lors de la désinstallation du module."

