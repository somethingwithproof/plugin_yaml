msgid "CSRF token validation failed. Reload the page and retry."
msgstr "Xác thực mã thông báo CSRF thất bại. Hãy tải lại trang và thử lại."

#: yaml_admin.php
msgid "Configure yaml_source_paths in Cacti Settings before running reload."
msgstr "Hãy cấu hình yaml_source_paths trong Cài đặt Cacti trước khi chạy tải lại."

#: yaml_admin.php
msgid "No matching pending reload plan was found in your session. Compute a fresh plan first."
msgstr "Không tìm thấy kế hoạch tải lại đang chờ phù hợp trong phiên của bạn. Hãy tính toán kế hoạch mới trước."

#: yaml_admin.php
msgid "YAML Reload & Monitoring Packs (Administrator)"
msgstr "Tải lại YAML & Gói giám sát (Quản trị viên)"

#: yaml_admin.php
msgid "Compute Reload Plan from Configured Sources"
msgstr "Tính toán kế hoạch tải lại từ các nguồn đã cấu hình"

#: yaml_operator.php
msgid "Provide a YAML document to validate or compile."
msgstr "Cung cấp một tài liệu YAML để kiểm tra hoặc biên dịch."

#: yaml_operator.php
#, php-format
msgid "Compiled %s successfully."
msgstr "Đã biên dịch %s thành công."

#: yaml_operator.php
msgid "YAML syntax, placeholders, and cross-parameter invariants passed."
msgstr "Cú pháp YAML, trình giữ chỗ và các bất biến liên tham số đều hợp lệ."

#: yaml_operator.php
msgid "YAML Validate, Compile & Dry-Run Preview (Operator)"
msgstr "Kiểm tra, biên dịch & xem trước chạy thử YAML (Vận hành viên)"

