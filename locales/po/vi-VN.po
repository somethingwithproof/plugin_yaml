msgid "YAML Template, Data Query, or CasC Fragment:"
msgstr "Mẫu YAML, Truy vấn dữ liệu hoặc Phân đoạn CasC:"

#: yaml_operator.php
msgid "Validate & Redact"
msgstr "Kiểm tra & Ẩn thông tin nhạy cảm"

#: yaml_operator.php
