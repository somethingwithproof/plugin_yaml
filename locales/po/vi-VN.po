#: lib/Settings.php
msgid "YAML Fragment Sources (casc.d)"
msgstr "Nguồn phân đoạn YAML (casc.d)"

#: lib/Settings.php
msgid "Comma-separated list of YAML files or casc.d directories merged in deterministic lexical order."
msgstr "Danh sách tệp YAML hoặc thư mục casc.d phân tách bằng dấu phẩy được hợp nhất theo thứ tự từ điển xác định."

#: lib/Settings.php
msgid "Fragment Merge Policy"
msgstr "Chính sách hợp nhất phân đoạn"

#: lib/Settings.php
msgid "Strict rejects conflicting scalar keys across fragments; overlay lets later fragments override earlier values."
msgstr "Nghiêm ngặt từ chối các khóa vô hướng xung đột giữa các phân đoạn; ghi đè cho phép các phân đoạn sau ghi đè giá trị trước đó."

#: lib/Settings.php
msgid "Strict (fail on scalar conflicts)"
msgstr "Nghiêm ngặt (lỗi khi xung đột giá trị vô hướng)"

#: lib/Settings.php
msgid "Overlay (later fragments override)"
msgstr "Ghi đè (phân đoạn sau ghi đè)"

#: lib/Settings.php
msgid "Monitoring Packs Directory"
msgstr "Thư mục gói giám sát"

#: lib/Settings.php
msgid "Base directory containing versioned YAML Monitoring Packs and lockfiles."
msgstr "Thư mục gốc chứa các Gói giám sát YAML có phiên bản và tệp khóa."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Giữ lại bảng tiện ích khi gỡ cài đặt"

#: lib/Settings.php
msgid "Preserve plugin_yaml_packs, plugin_yaml_queries, and plugin_yaml_audit tables when uninstalling the plugin."
msgstr "Giữ lại các bảng plugin_yaml_packs, plugin_yaml_queries và plugin_yaml_audit khi gỡ cài đặt tiện ích mở rộng."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Tiện ích mở rộng YAML yêu cầu PHP %s trở lên. Máy chủ này đang chạy PHP %s, vì vậy tiện ích mở rộng chưa được cài đặt hoặc bật."

#: setup.php
msgid "Import/Export"
msgstr "Nhập/Xuất"

#: setup.php
msgid "YAML"
msgstr "YAML"

#: setup.php
msgid "The YAML plugin is not enabled."
msgstr "Tiện ích mở rộng YAML chưa được bật."

#: setup.php
#, php-format
msgid "The YAML plugin requires PHP %s or later."
msgstr "Tiện ích mở rộng YAML yêu cầu PHP %s trở lên."

