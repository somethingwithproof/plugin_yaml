msgstr "Адміністратор YAML"

#: lib/Pages.php
msgid "YAML Schema & Reference"
msgstr "Схема та довідник YAML"

#: lib/Pages.php
msgid "YAML Validate & Compile"
msgstr "Перевірка та компіляція YAML"

#: lib/Pages.php
